# Server Setup
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite with Prisma)
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET="replace_with_a_secure_jwt_secret_key"
JWT_EXPIRES_IN="7d"

# Integration API Keys (Test Mode Keys)
RAZORPAY_KEY_ID="rzp_test_change_this"
RAZORPAY_KEY_SECRET="change_this_secret"

# AI Layer Configurations
OPENAI_API_KEY="sk-proj-change_this"
OLLAMA_API_BASE_URL="http://localhost:11434"
USE_LOCAL_LLM=true

# Twilio & SMS Configurations (Optional/Later)
TWILIO_ACCOUNT_SID="AC_change_this"
TWILIO_AUTH_TOKEN="token_change_this"
TWILIO_NUMBER="+1234567890"

# WhatsApp Business Integration Details
WHATSAPP_API_TOKEN="token_change_this"
WHATSAPP_PHONE_NUMBER_ID="id_change_this"
