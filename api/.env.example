# ==========================================
# 1. CORE SERVER CONFIGURATION (CRITICAL)
# ==========================================
PORT=5050
NODE_ENV=production

# ==========================================
# 2. DATABASE CONFIGURATION (POSTGRESQL)
# ==========================================
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public&sslmode=prefer
DATABASE_URL="postgresql://postgres:password@localhost:5432/agriflow_db?schema=public"

# ==========================================
# 3. AUTHENTICATION & SECURITY (CRITICAL)
# ==========================================
# 64+ char random hex key for JWT signing (generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="replace_with_a_secure_random_64_character_hex_jwt_secret"
JWT_EXPIRES_IN="30d"

# Allowed Frontend Origins (comma-separated URLs, e.g. https://admin.yourdomain.com, or * for all)
CORS_ORIGIN="*"

# ==========================================
# 4. PAYMENT GATEWAY (RAZORPAY)
# ==========================================
# Replace with live keys in production (rzp_live_...) or test keys in development
RAZORPAY_KEY_ID="rzp_test_change_this"
RAZORPAY_KEY_SECRET="change_this_secret"

# ==========================================
# 5. AI LAYER CONFIGURATIONS (OPTIONAL)
# ==========================================
OPENAI_API_KEY="sk-proj-change_this"
OLLAMA_API_BASE_URL="http://localhost:11434"
USE_LOCAL_LLM=false

# ==========================================
# 6. TWILIO & SMS SERVICE (OPTIONAL)
# ==========================================
TWILIO_ACCOUNT_SID="AC_change_this"
TWILIO_AUTH_TOKEN="token_change_this"
TWILIO_NUMBER="+1234567890"

# ==========================================
# 7. WHATSAPP BUSINESS INTEGRATION (OPTIONAL)
# ==========================================
WHATSAPP_API_TOKEN="token_change_this"
WHATSAPP_PHONE_NUMBER_ID="id_change_this"

# ==========================================
# 8. CLOUDINARY IMAGE STORAGE & CDN OPTIMIZATION
# ==========================================
CLOUDINARY_CLOUD_NAME="bbdmypjc"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_URL="cloudinary://<your_api_key>:<your_api_secret>@bbdmypjc"
