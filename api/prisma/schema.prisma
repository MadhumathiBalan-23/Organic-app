generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id                 String    @id @default(uuid())
  name               String    @unique
  emoji              String    @default("🌱")
  description        String?
  imageUrl           String?
  cloudinaryPublicId String?
  displayOrder       Int       @default(0)
  isActive           Boolean   @default(true)
  products           Product[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt @default(now())
}

model Banner {
  id                 String    @id @default(uuid())
  title              String
  subtitle           String?
  imageUrl           String
  cloudinaryPublicId String?
  backgroundColor    String    @default("#EBF6EE")
  textColor          String    @default("#003B25")
  buttonColor        String    @default("#F2C500")
  buttonTextColor    String    @default("#18352B")
  buttonText         String    @default("Shop Now →")
  targetType         String    @default("SCREEN") // SCREEN, CATEGORY, PRODUCT, SUBSCRIPTION
  targetId           String    @default("ALL_PRODUCTS")
  displayOrder       Int       @default(0)
  isActive           Boolean   @default(true)
  startAt            DateTime?
  endAt              DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Product {
  id                  String         @id @default(uuid())
  name                String
  categoryName        String
  category            Category?      @relation(fields: [categoryName], references: [name])
  brand               String         @default("NatureFarm")
  price               Float
  originalPrice       Float?
  discountBadge       String?
  unit                String         @default("Kg")
  rating              Float          @default(4.8)
  stock               Int            @default(100)
  minStock            Int            @default(15)
  availabilityStart   String         @default("06:00 AM")
  availabilityEnd     String         @default("09:00 PM")
  description         String
  benefits            String         @default("[]") // JSON string of benefits
  imageUrl            String
  cloudinaryPublicId  String?
  vendorId            String?
  vendor              Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  subscriptionAllowed Boolean        @default(true)
  oneTimeAllowed      Boolean        @default(true)
  organicCertified    Boolean        @default(true)
  emoji               String         @default("🌱")
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  subscriptions       Subscription[]
  orderItems          OrderItem[]
  cartItems           CartItem[]
  subscriptionSettings ProductSubscriptionSettings?
}

model Vendor {
  id               String         @id @default(uuid())
  userId           String?        @unique
  user             User?          @relation(fields: [userId], references: [id])
  businessName     String
  ownerName        String
  phoneNumber      String         @unique
  email            String?
  address          String
  latitude         Float?         @default(0)
  longitude        Float?         @default(0)
  deliveryRadiusKm Float          @default(15.0)
  rating           Float          @default(4.9)
  status           String         @default("ACTIVE") // ACTIVE, PENDING, SUSPENDED
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  products         Product[]
  orders           Order[]
  subscriptions    Subscription[]
  cartItems        CartItem[]
}

model User {
  id            String         @id @default(uuid())
  fullName      String
  email         String?
  phoneNumber   String         @unique
  role          String         @default("customer") // admin, vendor, customer
  passwordHash  String         @default("OTP_VERIFIED")
  location      String?        @default("Chennai, TN")
  status        String         @default("Active") // Active, VIP, Inactive
  vendorStatus  String?        @default("NONE") // NONE, PENDING, APPROVED, REJECTED
  totalOrders   Int            @default(0)
  totalSpend    Float          @default(0)
  isPhoneVerified Boolean        @default(true)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
  orders        Order[]
  cartItems     CartItem[]
  vendor        Vendor?
  devices       UserDevice[]
  refreshTokens RefreshToken[]
  loginHistories LoginHistory[]
}

model Brand {
  id           String    @id @default(uuid())
  name         String    @unique
  emoji        String    @default("🌱")
  origin       String
  productCount Int       @default(0)
  established  String    @default("2020")
  rating       Float     @default(4.5)
  createdAt    DateTime  @default(now())
}

model Delivery {
  id           String    @id @default(uuid())
  customerName String
  address      String
  products     String
  quantity     String
  deliveryTime String
  status       String    @default("Assigned") // Assigned, Picked Up, Out for Delivery, Delivered, Failed
  createdAt    DateTime  @default(now())
}

model UserLog {
  id        String   @id @default(uuid())
  user      String
  role      String
  action    String
  module    String
  ip        String   @default("127.0.0.1")
  type      String   @default("view") // create, update, delete, login, logout, view
  timestamp DateTime @default(now())
}

model AIAlert {
  id        String   @id @default(uuid())
  type      String
  text      String
  time      String
  severity  String   @default("info")
  createdAt DateTime @default(now())
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id])
  vendorId             String?
  vendor               Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  customerPhone        String?
  customerName         String?
  deliveryAddress      String?
  productId            String
  product              Product  @relation(fields: [productId], references: [id])
  quantity             Float    @default(1)
  unit                 String   @default("Kg")
  frequency            String   @default("Daily") // Daily, Weekly, Monthly
  selectedDays         String   @default("[]") // JSON string of days, e.g. ["Mon","Wed","Fri"]
  selectedDates        String   @default("[]") // JSON string of dates, e.g. [1,15]
  deliveryTime         String   @default("06:30 AM")
  deliverySlot         String?
  slotType             String   @default("RECOMMENDED") // RECOMMENDED, CUSTOM
  duration             Int      @default(30)
  startDate            String
  endDate              String?
  totalDeliveries      Int      @default(30)
  pricePerDelivery     Float    @default(0)
  priceTotal           Float
  paymentStatus        String   @default("Paid")
  status               String   @default("Active") // Active, Paused, Cancelled
  autoRenew            Boolean  @default(true)
  confirmationRequired Boolean  @default(true)
  skippedDates         String   @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt @default(now())
  schedules            SubscriptionDeliverySchedule[]
}

model SubscriptionDeliverySchedule {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  deliveryDate   String       // YYYY-MM-DD
  deliveryTime   String
  status         String       @default("SCHEDULED") // SCHEDULED, DELIVERED, SKIPPED, CANCELLED
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
  @@index([deliveryDate])
}

model ProductSubscriptionSettings {
  id                     String   @id @default(uuid())
  productId              String   @unique
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  isSubscriptionEnabled  Boolean  @default(true)
  allowedFrequencies     String   @default("[\"Daily\",\"Weekly\",\"Monthly\"]") // JSON array
  minimumQuantity        Float    @default(1)
  maximumQuantity        Float    @default(10)
  quantityUnit           String   @default("Kg") // Kg, Litre, Gram, ml, Piece
  unitMultipliers        String   @default("[]") // JSON array of preset options
  allowedDeliverySlots   String   @default("[]") // JSON array of slots
  customTimeAllowed      Boolean  @default(true)
  morningDeliveryEnabled Boolean  @default(true)
  eveningDeliveryEnabled Boolean  @default(false)
  defaultSlot            String?  @default("06:00 AM - 08:00 AM")
  minimumDuration        Int      @default(15)
  maximumDuration        Int      @default(90)
  deliveryCutoffTime     String   @default("21:00") // 9 PM
  categoryNotice         String?
  badgeText              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Order {
  id            String      @id @default(uuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  vendorId      String?
  vendor        Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String
  deliveryAddress String
  totalAmount   Float
  deliveryFee   Float       @default(0)
  distanceKm    Float       @default(0)
  deliverySlot  String?
  deliveryOtp   String?
  vendorPhone   String?
  orderType     String      @default("One-Time")
  paymentStatus String      @default("SUCCESS")
  deliveryStatus String     @default("CONFIRMED")
  paymentMethod String      @default("UPI")
  createdAt     DateTime    @default(now())
  items         OrderItem[]

  @@index([vendorId])
  @@index([userId])
  @@index([customerPhone])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  price     Float
  unitPrice Float    @default(0)
  subtotal  Float    @default(0)
}

model VendorRequest {
  id              String    @id @default(uuid())
  userId          String?
  userName        String
  phoneNumber     String
  farmName        String
  farmLocation    String
  cropCategories  String    @default("Fresh Vegetables & Dairy")
  experienceYears String?   @default("3")
  certificateNo   String?   @default("NPOP-ORG-TN-4821")
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CartItem {
  id          String   @id @default(uuid())
  phoneNumber String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendorId    String?
  vendor      Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  quantity    Int      @default(1)
  unit        String   @default("Kg")
  price       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([phoneNumber, productId])
  @@index([phoneNumber])
  @@index([vendorId])
}

model UserDevice {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId        String
  deviceName      String?
  deviceModel     String?
  deviceType      String         @default("mobile") // mobile, tablet, web
  operatingSystem String?        @default("Android")
  osVersion       String?
  appVersion      String?        @default("1.0.0")
  isTrusted       Boolean        @default(false)
  isActive        Boolean        @default(true)
  trustedAt       DateTime?
  lastLoginAt     DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  refreshTokens   RefreshToken[]
  loginHistories  LoginHistory[]

  @@unique([userId, deviceId])
  @@index([deviceId])
  @@index([userId])
}

model OtpVerification {
  id           String    @id @default(uuid())
  userId       String?
  phoneNumber  String
  otpHash      String
  role         String    @default("customer") // customer, vendor, admin
  purpose      String    @default("LOGIN")
  expiresAt    DateTime
  attemptCount Int       @default(0)
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([phoneNumber])
  @@index([expiresAt])
}

model RefreshToken {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userDeviceId  String
  userDevice    UserDevice  @relation(fields: [userDeviceId], references: [id], onDelete: Cascade)
  tokenHash     String      @unique
  tokenFamilyId String
  role          String      @default("customer")
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  lastUsedAt    DateTime    @default(now())

  @@index([userId])
  @@index([tokenFamilyId])
  @@index([userDeviceId])
}

model LoginHistory {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userDeviceId String?
  userDevice   UserDevice? @relation(fields: [userDeviceId], references: [id], onDelete: SetNull)
  role         String      @default("customer")
  loginType    String      @default("OTP") // OTP, TRUSTED_DEVICE_REFRESH
  loginStatus  String      @default("SUCCESS") // SUCCESS, FAILED
  ipAddress    String      @default("127.0.0.1")
  userAgent    String?
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([createdAt])
}

